# Development defaults for the Base44 sandbox stack.
#
# Only non-secret placeholders belong here. Provider credentials are added
# in the Base44 secrets dashboard and must never be committed to GitHub.
#
# Admin bootstrap: change before exposing a self-hosted deployment.
ADMIN_EMAIL=admin@musicai.studio
ADMIN_PASSWORD=changeme-admin
ADMIN_NAME=Studio Admin

# Generation safety limits (server-enforced, per user)
GENERATION_MAX_ACTIVE=3
GENERATION_HOURLY_LIMIT=20

# Provider-wide daily audio ceiling in seconds. Set to 0 only if you
# intentionally want no application-level daily cap.
PROVIDER_DAILY_SECONDS_CAP=7200

# Music provider: lyria (Google Lyria 3 Pro), replicate, or elevenlabs
MUSIC_PROVIDER=lyria

# Google Lyria 3 Pro model
GOOGLE_LYRIA_MODEL=lyria-3-pro-preview

# Optional lyrics writer (OpenAI-compatible chat completions endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
