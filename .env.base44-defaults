# Development defaults for the Base44 sandbox stack.
#
# Only non-secret placeholders belong here. This file is listed FIRST in each
# service's env_file list, so anything the platform delivers to
# /run/base44/app.env (dashboard secrets, provider keys) overrides it.
#
# ADMIN_* seeds the first admin account on first boot. Change it before
# exposing this deployment to real users.

ADMIN_EMAIL=admin@musicai.studio
ADMIN_PASSWORD=changeme-admin
ADMIN_NAME=Studio Admin

# Generation safety limits (server-enforced, per user)
GENERATION_MAX_ACTIVE=3
GENERATION_HOURLY_LIMIT=20

# Total seconds of audio the whole installation may request per 24h.
# Protects the provider account; surfaced in the admin dashboard.
PROVIDER_DAILY_SECONDS_CAP=7200

# Music provider: "replicate" or "elevenlabs"
MUSIC_PROVIDER=replicate

# Replicate models (both default to ACE-Step: vocals/lyrics + instrumental)
REPLICATE_MUSIC_MODEL_VOCAL=lucataco/ace-step
REPLICATE_MUSIC_MODEL_INSTRUMENTAL=lucataco/ace-step

# ElevenLabs model (only used when MUSIC_PROVIDER=elevenlabs)
ELEVENLABS_MUSIC_MODEL=music_v1

# Lyrics writer (OpenAI-compatible chat completions endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
